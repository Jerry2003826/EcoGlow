#!/usr/bin/env bash
# Used as a default to seed config/.env which
# enables you to use environment variables to configure
# the aspects of your application that vary by
# environment.
#
# Having this file in production is considered a **SECURITY RISK** and also decreases
# the bootstrap performance of your application.
#
# To use this file, first copy it into `config/.env`. Also ensure the related
# code block for loading this file is uncommented in `config/bootstrap.php`
#
# In development .env files are parsed by PHP
# and set into the environment. This provides a simpler
# development workflow over standard environment variables.
export APP_NAME="__APP_NAME__"
export DEBUG="true"
export APP_ENCODING="UTF-8"
export APP_DEFAULT_LOCALE="en_US"
export APP_DEFAULT_TIMEZONE="UTC"
# SECURITY: the canonical public origin of the site. Set this to the real
# domain, with an "https://" scheme, before deploying. It is REQUIRED in
# production and three separate things break if it is wrong:
#
#   - Left empty with DEBUG=false, HostHeaderMiddleware throws an
#     InternalErrorException on every request, so the whole site returns 500.
#   - If the incoming Host header does not match this host, the same middleware
#     answers 400. Use the exact domain visitors reach, including any "www.".
#   - The password reset link is built with Router::url(..., true), so it
#     inherits this scheme. An "http://" value here emails a plaintext link and
#     leaks the reset token over the wire; HttpsEnforcerMiddleware only upgrades
#     the connection after the URL has already been sent.
export APP_FULL_BASE_URL="https://example.com"
export SECURITY_SALT="__SALT__"

# Public contact-form reCAPTCHA v2 keys (https://www.google.com/recaptcha/admin).
# Leave the secret empty to fail closed, or set RECAPTCHA_ENABLED=false to skip
# verification during local development.
export RECAPTCHA_ENABLED="true"
export RECAPTCHA_SITEKEY=""
export RECAPTCHA_SECRET=""

# Seeded account passwords. Must be at least 20 characters and not a placeholder
# such as admin123 / customer123. Leave empty so seeders refuse to run.
export ADMIN_SEED_PASSWORD=""
export CUSTOMER_SEED_PASSWORD=""

# Comma-separated proxy IPs that may supply X-Forwarded-* headers.
# Leave empty unless the origin only accepts those proxies.
export TRUSTED_PROXIES=""
# Leave SECURITY_REQUIRE_STAFF_MFA unset. An empty string is treated as
# "use the debug default" (required when DEBUG=false). Setting it to 0/false
# is the only way to turn staff MFA off.
export CSP_ENFORCE=""

# Outgoing email, used by the "forgot password" flow.
#
# EMAIL_TRANSPORT=Debug (the default) does not send anything: the rendered
# message is written to logs/debug.log, so the reset link can be copied from
# there during local development without any mail server.
#
# For production on cPanel, set EMAIL_TRANSPORT=Smtp and copy the values from
# "Email Accounts > Connect Devices" in the cPanel dashboard. EMAIL_FROM must
# be a mailbox the server actually hosts or delivery will be rejected.
export EMAIL_TRANSPORT="Debug"
export EMAIL_HOST="localhost"
export EMAIL_PORT="587"
export EMAIL_USERNAME=""
export EMAIL_PASSWORD=""
export EMAIL_TLS="true"
export EMAIL_FROM="no-reply@localhost"
export EMAIL_FROM_NAME="Eco Glow Lighting"

# Stripe Payment Element (https://dashboard.stripe.com/test/apikeys).
# Leave empty until you have test keys. Never commit live secrets.
export STRIPE_PUBLISHABLE_KEY=""
export STRIPE_SECRET_KEY=""
export STRIPE_WEBHOOK_SECRET=""

# Production throttling must use a reachable Redis engine (ext-redis required).
# Private hosts may use redis://; public hosts must use rediss:// and a password.
#export CACHE_LOGIN_THROTTLE_URL="redis://127.0.0.1:6379/0"

# Required when DEBUG=false. Send as X-Health-Token from the load balancer.
# Do not expose /health/ready to the public internet.
#export HEALTH_READY_TOKEN=""

# Uncomment these to define cache configuration via environment variables.
#export CACHE_DURATION="+2 minutes"
#export CACHE_DEFAULT_URL="file:///path/to/tmp/cache/?prefix=${APP_NAME}_default_&duration=${CACHE_DURATION}"
#export CACHE_CAKECORE_URL="file:///path/to/tmp/cache/persistent?prefix=${APP_NAME}_cake_translations_&serialize=true&duration=${CACHE_DURATION}"
#export CACHE_CAKEMODEL_URL="file:///path/to/tmp/cache/models?prefix=${APP_NAME}_cake_model_&serialize=true&duration=${CACHE_DURATION}"

# Uncomment these to define email transport configuration via environment variables.
#export EMAIL_TRANSPORT_DEFAULT_URL=""

# Uncomment these to define database configuration via environment variables.
#export DATABASE_URL="mysql://my_app:secret@localhost/${APP_NAME}?encoding=utf8&timezone=UTC&cacheMetadata=true&quoteIdentifiers=false&persistent=false"
#export DATABASE_TEST_URL="mysql://my_app:secret@localhost/test_${APP_NAME}?encoding=utf8&timezone=UTC&cacheMetadata=true&quoteIdentifiers=false&persistent=false"

# Uncomment these to define logging configuration via environment variables.
#export LOG_DEBUG_URL="file:///path/to/logs/?levels[]=notice&levels[]=info&levels[]=debug&file=debug"
#export LOG_ERROR_URL="file:///path/to/logs/?levels[]=warning&levels[]=error&levels[]=critical&levels[]=alert&levels[]=emergency&file=error"
